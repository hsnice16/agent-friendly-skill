{
  "name": "agent-friendly-skill",
  "version": "0.1.13",
  "private": true,
  "description": "Agent skill that scores the current repo for nine AI coding agents, reports the best-fit agent, and recommends a model class.",
  "license": "MIT",
  "author": "Himanshu Singh (https://github.com/hsnice16)",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "ignore": "7.0.5"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o skills/agent-friendly/dist --source-map --license licenses.txt",
    "format": "biome check --write",
    "lint": "biome check",
    "prepare-hooks": "lefthook install",
    "test": "node --test --import tsx tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "@vercel/ncc": "0.45.0",
    "lefthook": "2.2.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
